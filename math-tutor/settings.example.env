# Скопируйте этот файл в settings.env и заполните нужное. Пустые строки игнорируются.

# Порт на этом компьютере
PORT=3000

# Ключ Claude API для репетитора Алисы (https://console.anthropic.com). Без него Алиса выключена.
ANTHROPIC_API_KEY=

# Отправлять ссылку в Telegram-группу при каждом запуске (бот должен быть в группе)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TEXT=Репетитор по высшей математике открыт:

# 0 — не открывать доступ из интернета, только локальная сеть
TUNNEL=
